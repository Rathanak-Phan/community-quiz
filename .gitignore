# Global ignores
.DS_Store
Thumbs.db
*.log
*.lock
*.bak

# Environment files (MUST BE IGNORED FOR SECURITY)
.env
.env.local
.env.production
.env.production.local
.env.*.local

# Frontend specific
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example

# Backend specific
backend/vendor/
backend/node_modules/
backend/public/storage
backend/public/build
backend/public/hot
backend/storage/app/*
!backend/storage/app/public/
backend/storage/framework/*
backend/storage/logs/*
backend/storage/*.key
backend/bootstrap/cache/*
backend/.env
backend/.env.*
!backend/.env.example
backend/.phpunit.cache
backend/auth.json
backend/Homestead.json
backend/Homestead.yaml

# IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?